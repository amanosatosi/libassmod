# Public alpha rendering coverage also runs in make check when only the ART
# comparison/fuzz tools are enabled (the usual Autotools CI configuration).
check_PROGRAMS += test/alpha_parse_unit
TESTS += test/alpha_parse_unit$(EXEEXT)
AM_TESTS_ENVIRONMENT = ALPHA_TEST_FONT='$(abs_srcdir)/compare/test/font1.ttf'; export ALPHA_TEST_FONT;
test_alpha_parse_unit_SOURCES = test/alpha_parse_selftest.c
test_alpha_parse_unit_LDADD = libass/libass_internal.la
test_alpha_parse_unit_LDFLAGS = $(AM_LDFLAGS) -static
EXTRA_DIST += compare/test/font1.ttf

if ENABLE_TEST
noinst_PROGRAMS += test/test
check_PROGRAMS += test/scroll_unit test/scroll_render_unit
check_PROGRAMS += test/clip_transform_unit
check_PROGRAMS += test/rgba_registry_unit
TESTS += test/scroll_unit$(EXEEXT) test/scroll_render_unit$(EXEEXT) test/clip_transform_unit$(EXEEXT)
TESTS += test/rgba_registry_unit$(EXEEXT)
AM_TESTS_ENVIRONMENT += SCROLL_TEST_FONT='$(abs_srcdir)/compare/test/font1.ttf'; export SCROLL_TEST_FONT;
AM_TESTS_ENVIRONMENT += CLIP_TRANSFORM_TEST_FONT='$(abs_srcdir)/compare/test/font1.ttf'; export CLIP_TRANSFORM_TEST_FONT;
endif

test_rgba_registry_unit_SOURCES = test/rgba_registry_selftest.c
test_rgba_registry_unit_CFLAGS = $(AM_CFLAGS) $(REGISTRY_THREAD_CFLAGS)
test_rgba_registry_unit_LDADD = libass/libass_internal.la $(REGISTRY_THREAD_LIBS)
test_rgba_registry_unit_LDFLAGS = $(AM_LDFLAGS) -static
test_clip_transform_unit_SOURCES = test/clip_transform_selftest.c
test_clip_transform_unit_LDADD = libass/libass_internal.la
test_clip_transform_unit_LDFLAGS = $(AM_LDFLAGS) -static
test_scroll_unit_SOURCES = test/scroll_selftest.c
test_scroll_unit_LDADD = libass/libass_internal.la
test_scroll_unit_LDFLAGS = $(AM_LDFLAGS) -static
test_scroll_render_unit_SOURCES = test/scroll_render_selftest.c
test_scroll_render_unit_LDADD = libass/libass_internal.la
test_scroll_render_unit_LDFLAGS = $(AM_LDFLAGS) -static
test_test_SOURCES = test/test.c
test_test_LDADD = libass/libass.la
test_test_LDFLAGS = $(AM_LDFLAGS) $(LIBPNG_LIBS) -static

if ENABLE_PROFILE
noinst_PROGRAMS += profile/profile
endif
profile_profile_SOURCES = profile/profile.c
profile_profile_LDADD = libass/libass.la
profile_profile_LDFLAGS = $(AM_LDFLAGS) -static

if ENABLE_COMPARE
noinst_PROGRAMS += compare/compare
endif
compare_compare_SOURCES = compare/image.h  compare/image.c  compare/compare.c
compare_compare_LDADD = libass/libass_internal.la
compare_compare_LDFLAGS = $(AM_LDFLAGS) $(LIBPNG_LIBS) -static
EXTRA_DIST += compare/README.md

if ENABLE_FUZZ
noinst_PROGRAMS += fuzz/fuzz
endif
fuzz_fuzz_SOURCES = fuzz/fuzz.c fuzz/writeout.h fuzz/writeout.c
fuzz_fuzz_CPPFLAGS = $(AM_CPPFLAGS) $(FUZZ_CPPFLAGS)
fuzz_fuzz_LDADD = libass/libass.la
fuzz_fuzz_LDFLAGS = $(AM_LDFLAGS) $(FUZZ_LDFLAGS) -static

if ENABLE_FUZZ
fuzz/fuzz_ossfuzz: fuzz/fuzz-fuzz.o libass/libass.la $(srcdir)/libass.pc
	$$CXX $$CXXFLAGS -std=c++11 \
		-o $@ \
		fuzz/fuzz-fuzz.o \
		$$LIB_FUZZING_ENGINE libass/.libs/libass.a \
		-Wl,-Bstatic \
		$$(pkg-config --static --libs $(srcdir)/libass.pc | sed -e 's/-lm //g' -e 's/-lass //g') \
		-Wl,-Bdynamic
endif


if ENABLE_CHECKASM
check_PROGRAMS += checkasm/checkasm
TESTS += checkasm/checkasm$(EXEEXT)
bench: run-checkasm-bench
endif

.asm.o:
	$(nasm_verbose)$(AS) $(ASFLAGS) -I$(top_srcdir)/libass/ -o $@ $<

checkasm_checkasm_SOURCES = \
    checkasm/rasterizer.c \
    checkasm/blend_bitmaps.c \
    checkasm/be_blur.c \
    checkasm/blur.c \
    checkasm/checkasm.h checkasm/checkasm.c \
    libass/ass_rasterizer.h libass/ass_utils.h

checkasm_checkasm_CPPFLAGS = -I$(top_srcdir)/libass
checkasm_checkasm_LDADD = libass/libass_internal.la
checkasm_checkasm_LDFLAGS = $(AM_LDFLAGS) -static

if X86
checkasm_checkasm_SOURCES += checkasm/x86/checkasm.asm
endif
if AARCH64
checkasm_checkasm_SOURCES += checkasm/arm/checkasm_64.S
endif

run-checkasm: checkasm/checkasm$(EXEEXT)
	checkasm/checkasm$(EXEEXT)

run-checkasm-bench: checkasm/checkasm$(EXEEXT)
	checkasm/checkasm$(EXEEXT) --bench
